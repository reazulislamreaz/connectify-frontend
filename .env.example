# REST API via Next.js proxy (recommended — avoids CORS)
NEXT_PUBLIC_API_URL=/api

# ── Local dev ────────────────────────────────────────────────────────────────
BACKEND_PROXY_URL=http://localhost:8081
NEXT_PUBLIC_SOCKET_URL=http://localhost:8081
NEXT_PUBLIC_UPLOADS_URL=http://localhost:8081

# ── Local dev → remote VPS (http://localhost:3000) ───────────────────────────
# BACKEND_PROXY_URL=http://3.150.217.155/connectify
# NEXT_PUBLIC_SOCKET_URL=http://3.150.217.155
# NEXT_PUBLIC_SOCKET_PATH=/connectify/socket.io
# NEXT_PUBLIC_UPLOADS_URL=http://3.150.217.155/connectify

# ── Vercel production (https://easy-connectify.vercel.app) ───────────────────
# Requires HTTPS/WSS on the API host (Cloudflare proxied domain → VPS).
# Set these in Vercel → Project → Settings → Environment Variables, then redeploy.
#
# BACKEND_PROXY_URL=https://connectify-api.yourdomain.com/connectify
# NEXT_PUBLIC_SOCKET_URL=https://connectify-api.yourdomain.com
# NEXT_PUBLIC_SOCKET_PATH=/connectify/socket.io
# NEXT_PUBLIC_UPLOADS_URL=https://connectify-api.yourdomain.com/connectify
#
# Backend CLIENT_URL (all PM2 instances) must include:
#   https://easy-connectify.vercel.app

# ZEGOCLOUD credentials live on the backend only (see chatting-app-backend/.env.example)
